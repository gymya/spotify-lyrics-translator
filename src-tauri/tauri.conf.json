{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spotify Lyrics Translator", "version": "0.1.0", "identifier": "app.spotify-lyrics-translator.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      { "label": "main", "title": "Spotify Lyrics Translator", "width": 840, "height": 760, "minWidth": 640, "minHeight": 600, "backgroundColor": "#111512" },
      { "label": "overlay", "title": "浮動歌詞", "focus": false, "focusable": false, "acceptFirstMouse": true, "url": "index.html?overlay", "width": 540, "height": 120, "shadow": false, "transparent": true, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "visible": false }
    ],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["app", "dmg"], "icon": ["icons/icon.icns", "icons/icon.png"], "macOS": { "minimumSystemVersion": "12.0", "entitlements": "Entitlements.plist", "infoPlist": "Info.plist" } }
}
